    "A cor da interface não é gravada: vale até reiniciar o Bruce, e é arredondada para as cores de 16 bits do display. O brilho também não é salvo." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The interface color is not saved: it lasts until the Bruce reboots, and it is rounded to the display's 16-bit colors. Brightness is not saved either."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cor da interface não é gravada: vale até reiniciar o Bruce, e é arredondada para as cores de 16 bits do display. O brilho também não é salvo."
          }
        }
      }
    },
