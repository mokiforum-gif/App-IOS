    "—" : {
      "comment" : "A placeholder for the firmware version when it's not available.",
      "isCommentAutoGenerated" : true
    },
    "“cores próprias”: o efeito gera as próprias cores e ignora a cor escolhida. “vários LEDs”: só anima em placas com mais de um LED." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“own colors”: the effect generates its own colors and ignores the one you pick. “multiple LEDs”: only animates on boards with more than one LED."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“cores próprias”: o efeito gera as próprias cores e ignora a cor escolhida. “vários LEDs”: só anima em placas com mais de um LED."
          }
        }
      }
    },
